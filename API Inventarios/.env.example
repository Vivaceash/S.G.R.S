INVENTARIOS_HOST=127.0.0.1
INVENTARIOS_PORT=8002
INVENTARIOS_ENVIRONMENT=development
INVENTARIOS_ENABLE_DOCS=true
# Claves independientes. Sin claves, todas las consultas privadas se rechazan.
INVENTARIOS_API_KEYS=
# Claves de solo lectura para módulos externos; solo acceden a /cctv/integration/cameras.
INVENTARIOS_INTEGRATION_KEYS=
INVENTARIOS_WRITE_KEYS=
INVENTARIOS_EXPORT_KEYS=
INVENTARIOS_DASHBOARD_KEY=
INVENTARIOS_ENABLE_2FA=false
INVENTARIOS_ALLOW_2FA_ENROLLMENT=false
INVENTARIOS_JWT_SECRET_KEY=
INVENTARIOS_TOTP_SECRET_KEY=
INVENTARIOS_FORTI_URL=http://127.0.0.1:8001/api/v1
INVENTARIOS_FORTI_KEY=
INVENTARIOS_FORTI_AUTH_MODE=api-key
INVENTARIOS_FORTI_VDOM=root
INVENTARIOS_OMNI_URL=http://127.0.0.1:8000/api/v1
INVENTARIOS_OMNI_KEY=
INVENTARIOS_OMNI_AUTH_MODE=api-key
INVENTARIOS_STALE_SECONDS=120
INVENTARIOS_REFRESH_SECONDS=0
INVENTARIOS_RETENTION_DAYS=90
