# ==============================================================================
# S.G.R.S. - API Alcatel OmniVista 2500 (Configuración para Entorno Local / Intranet)
# ==============================================================================

# Entorno y Servidor Local
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ENVIRONMENT=development
DEBUG=false
ENABLE_DOCS=true

# Seguridad y Control de Acceso
# Clave(s) de API autorizadas (pueden ser múltiples separadas por coma).
# APP_API_KEY es obligatoria para cada consulta; nunca se reenvía a OmniVista.
APP_API_KEY=ClaveSeguraParaElNOC_OmniVista_2026
ALLOW_UNAUTHENTICATED=false

# Autenticación en Dos Pasos (2FA / TOTP)
ENABLE_2FA=false
ALLOW_2FA_ENROLLMENT=false
TOTP_SECRET_KEY=
JWT_SECRET_KEY=sgrs-secure-jwt-secret-key-change-in-production-2026
SESSION_EXPIRE_HOURS=1

# Limitador de Tasa de Peticiones (Sliding Window en memoria)
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10
MAX_REQUEST_BODY_BYTES=1048576

# Orígenes CORS permitidos (Intranet Local)
CORS_ORIGINS=http://192.168.38.250:3000,http://192.168.38.250:3001,http://localhost:3000,http://127.0.0.1:3000
ALLOWED_HOSTS=192.168.38.250,localhost,127.0.0.1
TRUSTED_PROXY_IPS=

# Enmascaramiento de IPs en respuestas de diagnóstico
MASK_INTERNAL_IPS=true

# Parámetros de Enlace con Alcatel OmniVista 2500 NMS
OV_HOST=192.168.10.201
OV_PORT=443
OV_PROTOCOL=https
OV_AUTH_MODE=credentials
OV_USERNAME=usuario_api_solo_lectura
OV_PASSWORD=
# Deprecated: dejar vacío. El upstream se autentica con OV_USERNAME/OV_PASSWORD.
OV_API_KEY=
OV_VERIFY_SSL=true
