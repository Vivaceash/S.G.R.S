# Configuración de conexión con Alcatel-Lucent OmniVista 2500 NMS

# Dirección IP o nombre de host (FQDN) del servidor OmniVista 2500
OV_HOST=192.168.1.100

# Puerto (por defecto 443 para HTTPS, o 8443 según tu instalación)
OV_PORT=443

# Protocolo (https por defecto)
OV_PROTOCOL=https

# Desactivar verificación de certificado SSL si OmniVista usa certificado autofirmado (true/false)
OV_VERIFY_SSL=false

# Método 1: API Key generada en OmniVista (External Apps / REST API)
OV_API_KEY=tu_api_key_aqui

# Método 2: Credenciales de Administrador (para obtener token de sesión JWT vía /api/login)
OV_USERNAME=admin
OV_PASSWORD=tu_password_aqui
