# =========================================================
# Configuración de Conexión a Alcatel-Lucent OmniVista 2500
# =========================================================

# Dirección IP o nombre de host (FQDN) del servidor OmniVista 2500
OV_HOST=192.168.10.201
OV_PORT=443
OV_PROTOCOL=https

# Verificación de certificados SSL (true/false)
# Si es false, se admiten certificados autofirmados
OV_VERIFY_SSL=false

# Ruta opcional a un paquete de certificados CA corporativos (ej. /ruta/a/ca.pem o C:\\certs\\ca.crt)
# OV_CA_BUNDLE=

# Método 1: API Key generada en OmniVista (External Apps / REST API)
OV_API_KEY=tu_api_key_de_omnivista_aqui

# Método 2: Credenciales de Administrador (para login y generación de tokens de sesión)
OV_USERNAME=admin
OV_PASSWORD=tu_password_aqui

# =========================================================
# Seguridad de la API Backend (Nuestra API)
# =========================================================

# Clave(s) de acceso para consumir esta API. 
# Puedes especificar una clave o varias separadas por coma para permitir rotación de credenciales.
# Clientes deben enviarla mediante cabecera 'X-API-KEY: <clave>' o 'Authorization: Bearer <clave>'.
# Puedes generar una clave segura con: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=cambiar_por_clave_segura_de_32_o_mas_caracteres

# Permitir modo no autenticado para desarrollo local (true/false). Por defecto: false
ALLOW_UNAUTHENTICATED=false

# Limitador de tasa de peticiones (Rate Limiting) por IP por minuto
RATE_LIMIT_PER_MINUTE=60

# Habilitar o deshabilitar la documentación interactiva Scalar y OpenAPI en /docs y /openapi.json
ENABLE_DOCS=true

# Ocultar o enmascarar direcciones IP de infraestructura en el endpoint de diagnóstico de salud (/health)
MASK_INTERNAL_IPS=true

# =========================================================
# Configuración CORS y Red
# =========================================================
# Orígenes permitidos (separados por coma). No usar '*' en entornos de producción si se admiten credenciales
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# Configuración del Servidor Local
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
