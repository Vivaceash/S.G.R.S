# ==========================================
# Configuración de la API Fortinet (Puerto 8001)
# ==========================================

# Puerto y Host del servidor FastAPI
PORT=8001
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=true

# Seguridad de nuestra API (requerido en Header: X-API-Key o Authorization: Bearer <key>)
# Soporta múltiples claves separadas por coma (ej. admin,key_cliente_dashboard,token_monitoreo)
APP_API_KEY=admin

# Permitir explícitamente modo no autenticado (solo para desarrollo/pruebas locales aisladas)
ALLOW_UNAUTHENTICATED=false

# Límite de peticiones por minuto (Rate Limiting anti DoS / Fuerza Bruta)
RATE_LIMIT_PER_MINUTE=120

# Tamaño máximo del cuerpo de la petición en bytes (1048576 = 1MB)
MAX_REQUEST_BODY_BYTES=1048576

# Orígenes CORS permitidos (separados por coma). IMPORTANTE: Si se usa "*", las credenciales se deshabilitan por seguridad
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,http://localhost:8001

# Exposición de documentación interactiva Scalar / OpenAPI (desactivar en producción pública si es necesario)
ENABLE_DOCS=true

# Enmascarar IPs y número de serie del hardware en respuestas del endpoint /health
MASK_INTERNAL_IPS=true

# ==========================================
# Conexión con FortiGate / FortiOS
# ==========================================

# Dirección IP o nombre de host del FortiGate (ej. 192.168.1.1 o 10.0.0.1)
FORTIOS_HOST=192.168.1.1

# Puerto HTTPS de administración del FortiGate (por defecto 443, o personalizado ej. 8443, 10443)
FORTIOS_PORT=443

# Protocolo (https recomendado)
FORTIOS_SCHEME=https

# API Token generado en FortiGate (System -> Administrators -> REST API Admin)
FORTIOS_API_TOKEN=tu_token_aqui

# VDOM por defecto (generalmente "root")
FORTIOS_DEFAULT_VDOM=root

# Verificar certificado SSL del FortiGate
# (false si el FortiGate usa certificado autofirmado; true si tiene certificado con CA válida)
FORTIOS_VERIFY_SSL=false

# Ruta al archivo de certificado CA corporativo (bundle PEM) para validación estricta de TLS
# FORTIOS_CA_BUNDLE=/ruta/hacia/ca-bundle.pem

# Timeout en segundos para peticiones hacia el FortiGate
FORTIOS_TIMEOUT=15.0
