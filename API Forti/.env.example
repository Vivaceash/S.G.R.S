# ==========================================
# Configuración de la API Fortinet (Puerto 8001)
# ==========================================

# Puerto y Host del servidor FastAPI
PORT=8001
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=true

# Seguridad de nuestra API (requerido en Header: X-API-Key)
# Puedes cambiar esta clave por cualquier cadena secreta o dejarla vacía para desactivar en desarrollo
APP_API_KEY=forti-secret-api-key-change-me

# Límite de peticiones (Rate Limiting) para evitar abusos o ataques DoS
RATE_LIMIT_PER_MINUTE=120

# ==========================================
# Conexión con FortiGate / FortiOS
# ==========================================

# Dirección IP o nombre de host del FortiGate (ej. 192.168.1.1 o 10.0.0.1)
FORTIOS_HOST=192.168.1.1

# Puerto HTTPS de administración del FortiGate (por defecto 443, o personalizado ej. 8443, 10443)
FORTIOS_PORT=443

# Protocolo (https recomendado)
FORTIOS_SCHEME=https

# API Token generado en FortiGate (REST API Admin)
FORTIOS_API_TOKEN=tu_token_aqui

# VDOM por defecto (generalmente "root")
FORTIOS_DEFAULT_VDOM=root

# Verificar certificado SSL del FortiGate
# (false si el FortiGate usa certificado autofirmado; true si tiene certificado con CA válida)
FORTIOS_VERIFY_SSL=false

# Timeout en segundos para peticiones hacia el FortiGate
FORTIOS_TIMEOUT=15.0
