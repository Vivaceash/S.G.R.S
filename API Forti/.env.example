# ==============================================================================
# S.G.R.S. - API Fortinet FortiGate (Configuración para Entorno Local / Intranet)
# ==============================================================================

# Entorno y Servidor Local
APP_NAME="Fortinet FortiGate REST Integration API"
APP_VERSION="1.0.0"
HOST=0.0.0.0
PORT=8001
ENVIRONMENT=development
DEBUG=false
ENABLE_DOCS=true

# Seguridad y Control de Acceso
# Clave(s) de API autorizadas (pueden ser múltiples separadas por coma).
# APP_API_KEY es obligatoria para cada consulta al gateway.
APP_API_KEY=ClaveSeguraParaElNOC_FortiGate_2026
ALLOW_UNAUTHENTICATED=false

# Autenticación en Dos Pasos (2FA / TOTP)
ENABLE_2FA=false
ALLOW_2FA_ENROLLMENT=false
TOTP_SECRET_KEY=
JWT_SECRET_KEY=sgrs-secure-jwt-secret-key-change-in-production-2026
SESSION_EXPIRE_HOURS=1

# Limitador de Tasa de Peticiones (Sliding Window en memoria)
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
MAX_REQUEST_BODY_BYTES=1048576

# Hosts y Orígenes CORS permitidos (Intranet Local)
ALLOWED_HOSTS=192.168.38.250,localhost,127.0.0.1
TRUSTED_PROXY_IPS=
CORS_ORIGINS=http://192.168.38.250:3000,http://192.168.38.250:3001,http://localhost:3000,http://127.0.0.1:3000

# Enmascaramiento de IPs y Seriales en respuestas de diagnóstico
MASK_INTERNAL_IPS=true

# Parámetros de Enlace con el Appliance FortiGate (FortiOS)
FORTIOS_HOST=192.168.1.1
FORTIOS_PORT=443
FORTIOS_SCHEME=https
# Credencial separada del APP_API_KEY; se valida al arrancar y en cada consulta upstream.
FORTIOS_API_TOKEN=tu_token_de_fortios_aqui
FORTIOS_DEFAULT_VDOM=root
FORTIOS_VERIFY_SSL=true
FORTIOS_TIMEOUT=15.0
