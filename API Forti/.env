# ==========================================
# Configuración de la API Fortinet (Puerto 8001)
# ==========================================

# Puerto y Host del servidor FastAPI
PORT=8001
HOST=127.0.0.1
ENVIRONMENT=production
DEBUG=false

# Seguridad de nuestra API (requerido en Header: X-API-Key)
APP_API_KEY=oKTuJ0&EGk*b$1k8&#0k

# Orígenes CORS permitidos
CORS_ORIGINS=http://192.168.38.250:3000,http://192.168.38.250:3001,http://localhost:3000,http://127.0.0.1:3000,http://15.40.2.15:3000,http://100.124.6.37:3000

# Límite de peticiones (Rate Limiting)
RATE_LIMIT_PER_MINUTE=120

# ==========================================
# Conexión con FortiGate / FortiOS
# ==========================================

# Dirección IP o nombre de host del FortiGate
FORTIOS_HOST=192.168.10.254

# Puerto HTTPS de administración del FortiGate
FORTIOS_PORT=443

# Protocolo (https)
FORTIOS_SCHEME=https

# Pega aquí el token que generaste en el FortiGate
FORTIOS_API_TOKEN="1q5xN7ms3bffj7b07prpfhj0Hd5tm0"

# VDOM por defecto (generalmente "root")
FORTIOS_DEFAULT_VDOM=root

# Verificar certificado SSL del FortiGate (false para certificados autofirmados)
FORTIOS_VERIFY_SSL=false
FORTIOS_ALLOW_UNVERIFIED_TLS=true
FORTIOS_CA_BUNDLE=
REQUIRE_PROVIDER_ON_STARTUP=false

# Timeout en segundos
FORTIOS_TIMEOUT=15.0
ALLOWED_HOSTS=192.168.38.250,localhost,127.0.0.1,15.40.2.15,100.124.6.37
JWT_SECRET_KEY=bV0SiN8I2eTZDMzf_q70tS60XM1bapDEA0f4m_8yT2tpAoa6L91ruB-5-7DYpjVy
