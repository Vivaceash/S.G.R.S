# ==========================================
# Configuración de la API Fortinet (Puerto 8001)
# ==========================================

# Puerto y Host del servidor FastAPI
PORT=8001
HOST=0.0.0.0
ENVIRONMENT=development
DEBUG=true

# Seguridad de nuestra API (requerido en Header: X-API-Key)
APP_API_KEY="admin"

# Límite de peticiones (Rate Limiting)
RATE_LIMIT_PER_MINUTE=120

# ==========================================
# Conexión con FortiGate / FortiOS
# ==========================================

# Dirección IP o nombre de host del FortiGate
FORTIOS_HOST=192.168.10.254

# Puerto HTTPS de administración del FortiGate
FORTIOS_PORT=443

# Protocolo (https)
FORTIOS_SCHEME=https

# Pega aquí el token que generaste en el FortiGate
FORTIOS_API_TOKEN="t5rxhNm0d3z4Qwkf8fhrdQ5Nxywbcr"

# VDOM por defecto (generalmente "root")
FORTIOS_DEFAULT_VDOM=root

# Verificar certificado SSL del FortiGate (false para certificados autofirmados)
FORTIOS_VERIFY_SSL=false

# Timeout en segundos
FORTIOS_TIMEOUT=15.0
